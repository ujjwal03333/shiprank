{
  "name": "@shiprank/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing the ShipRank scan engine as tools for Claude Code, Cursor, and other MCP clients",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "shiprank-mcp": "dist/bin.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/bin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@shiprank/engine": "workspace:*",
    "@shiprank/database": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@shiprank/tsconfig": "workspace:*",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
