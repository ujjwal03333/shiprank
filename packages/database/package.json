{
  "name": "@shiprank/database",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./migrations/*": "./supabase/migrations/*",
    "./seed": "./supabase/seed/seed.sql"
  },
  "scripts": {
    "migrate": "supabase db push",
    "reset": "supabase db reset",
    "seed": "supabase db reset --linked",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@shiprank/tsconfig": "workspace:*",
    "typescript": "^5.7.2"
  }
}
