{
  "framework": "nextjs",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@shiprank/web",
  "installCommand": "cd ../.. && pnpm install",
  "outputDirectory": ".next",
  "functions": {
    "app/api/dare/**/*.ts": {
      "maxDuration": 60
    },
    "app/api/cron/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/rescan",
      "schedule": "0 0 * * *"
    }
  ]
}
