# ─────────────────────────────────────────────────────────────────────────
# ShipRank environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# Generate your own secrets — do not paste them into any assistant.
# ─────────────────────────────────────────────────────────────────────────

# Supabase (server-side; service-role key is the DB master password — keep secret)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic (compile endpoint)
ANTHROPIC_API_KEY=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Scan attestations (Part 1)
# Generate with:  openssl rand -hex 32
ATTESTATION_SECRET=

# Stripe (Part 8 — create a Stripe account, use test-mode keys locally)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (Part 9 — regression alert emails)
RESEND_API_KEY=

# Cron protection (Part 9 — optional; Vercel Cron sends this as a Bearer
# token automatically once set. Generate with: openssl rand -hex 32)
CRON_SECRET=

# Public base URL used in badge/verify links (Part 4)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — raises GitHub API rate limits for Dare Board
GITHUB_TOKEN=
